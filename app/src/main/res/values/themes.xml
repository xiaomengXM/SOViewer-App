<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      主主题。
      注意：所有 Activity 都继承 AppCompatActivity，因此必须使用 AppCompat 系主题。
      之前用的 Theme.Material3.* 与 AppCompatActivity 不兼容，会导致控件点击无响应。
    -->
    <style name="Theme.SOViewer" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">#1565C0</item>
        <item name="colorPrimaryDark">#0D47A1</item>
        <item name="colorAccent">#1565C0</item>
        <item name="colorControlNormal">#757575</item>
        <item name="colorControlActivated">#1565C0</item>
        <item name="android:statusBarColor">#1565C0</item>
        <item name="android:windowBackground">?android:attr/colorBackground</item>
    </style>

    <!--
      打开方式中转页：透明、无动画，用户无感知
    -->
    <style name="Theme.SOViewer.Transparent" parent="Theme.SOViewer">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>

    <!--
      设置页主题。
      PreferenceFragmentCompat 额外依赖 preferenceTheme 与 AppCompat 控件属性。
    -->
    <style name="Theme.SOViewer.Settings" parent="Theme.SOViewer">
        <item name="preferenceTheme">@style/PreferenceThemeOverlay</item>
    </style>

    <!--
      注意：不要为 AlertDialog 指定自定义主题。
      AlertDialog.Builder(ctx, themeResId) 的 themeResId 必须是 alertDialogTheme 类型，
      传入外观不完整的主题（缺 windowMinWidthMajor / windowBackground 等）
      会导致弹窗布局塌缩，内容完全不可见。
      本项目的弹窗统一走 Activity 主题（Theme.SOViewer）自带的 alertDialogTheme。
    -->
</resources>